  "fieldVisibilityRules": {
    "neverInSnapshot": ["roomPassword","participantCredential","spectatorToken","sessionId","claimSecret"],
    "hostOnly": ["eligibleProfiles","credentialKind","claimOwnerLabel","recordStatus"],
    "participantOnly": ["claimState","claimId"],
    "spectator": ["roomId","teams","cards","recordsSummary"],
    "rule": "字段是否出现完全由服务端角色化快照决定；客户端不得从角色名推导或补回字段"
  },
  "responsive": {
    "viewports": ["desktop", "320px", "390px", "520px"],
    "layouts": {
      "host": {"desktop":"设置 + 待分配区 + 队伍画布调度台","320px":"纵向队伍栈；固定主要操作区","390px":"纵向队伍栈；展开式设置","520px":"纵向队伍栈；允许双列摘要"},
      "participant": {"desktop":"分队矩阵 + 本人认领/释放入口","320px":"分页队伍矩阵；本人入口置顶","390px":"分页队伍矩阵；牌详情抽屉","520px":"分页矩阵或两列卡片"},
      "spectator": {"desktop":"只读分队矩阵，不渲染写控件","320px":"总览聚焦纵向布局","390px":"总览聚焦 + 可折叠队伍","520px":"总览聚焦 + 双列摘要"}
    },
    "roles": {
      "host": ["loading","empty","connected","recovering","polling","unreadable","conflict","ended","deleted","credentialInvalid"],
      "participant": ["loading","empty","connected","recovering","polling","unreadable","conflict","ended","deleted","credentialInvalid"],
      "spectator": ["loading","empty","connected","recovering","polling","unreadable","conflict","ended","deleted","credentialInvalid"]
    }
  },
  "stateDefinitions": {
    "loading": {"controls":"disabled","display":"首次读取骨架；不显示旧角色写控件","announcement":"正在加载房间"},
    "empty": {"controls":"按 capability；无对象操作禁用","display":"角色专属空态和下一步","announcement":"房间当前没有人员牌或队伍"},
    "connected": {"controls":"仅按服务端 capability","display":"已连接文字 + 状态图标","announcement":"实时连接已恢复"},
    "recovering": {"controls":"写前强制刷新快照","display":"正在恢复；立即全量读取","announcement":"连接中断，正在恢复最新状态"},
    "polling": {"controls":"快照可读才允许 capability 写入","display":"每 15 秒轮询降级，不把通知当历史","announcement":"实时连接不可用，已切换定时刷新"},
    "unreadable": {"controls":"all disabled","display":"保留稳定容器并说明无法读取","announcement":"无法读取最新状态，操作已暂停"},
    "conflict": {"controls":"冲突意图不重放；刷新后等待用户决定","display":"操作未应用，房间已更新","announcement":"操作冲突，已刷新房间，请重新决定"},
    "ended": {"controls":"房间写禁用；服务端可单独授予 reopen","display":"已结束只读标识","announcement":"房间已结束，当前为只读"},
    "deleted": {"controls":"普通访问者无控件；管理员可见恢复 capability","display":"不可见终态并关闭 SSE","announcement":"房间不可用，实时连接已停止"},
    "credentialInvalid": {"controls":"该匿名上下文全部禁用","display":"提示重新输入密码或链接失效；关闭 SSE","announcement":"访问凭据已失效，实时连接已停止"}
  },
  "transitions": [
    {"id":"outOfOrderNotification","from":"connected|recovering|polling","trigger":"notification.revision <= appliedRevision","to":"same","effect":"ignore","invariant":"不回退、不按通知次数合并"},
    {"id":"newerNotification","from":"connected|recovering|polling","trigger":"notification.revision > targetRevision","to":"loadingLatest","effect":"raiseTargetAndFetchSingleFlight","invariant":"同房间最多一个快照读取在途"},
    {"id":"lateSnapshot","from":"loadingLatest","trigger":"snapshot.revision < appliedRevision or snapshot.revision < targetRevision","to":"loadingLatest","effect":"discardAndRefetch","invariant":"旧快照不得覆盖新状态"},
    {"id":"disconnectRecovery","from":"connected","trigger":"SSE error/close","to":"recovering","effect":"fetchNowThenPollEvery15Seconds","invariant":"断线不改变权威房间状态"},
    {"id":"realtimeRestored","from":"recovering|polling","trigger":"SSE open","to":"recovering","effect":"calibrateSnapshotThenConnected","invariant":"校准完成前不得停止轮询"},
    {"id":"terminal401","from":"anyNonTerminal","trigger":"snapshot/SSE returns 401","to":"credentialInvalid","effect":"stopRealtime","invariant":"停止重连；不删除认领或历史"},
    {"id":"terminal404","from":"anyNonTerminal","trigger":"snapshot/SSE returns 404","to":"deleted","effect":"stopRealtime","invariant":"普通访问者不区分删除与不存在"},
    {"id":"conflict409","from":"connected|recovering|polling","trigger":"command returns 409","to":"conflict","effect":"showNotAppliedAndFetchSnapshot","automaticReplay":"never","invariant":"刷新后由用户重新决定"},
    {"id":"writeWhileDegraded","from":"recovering|polling","trigger":"user activates allowed write","to":"preflightSnapshot","effect":"readLatestBeforeCommand","invariant":"读取失败才禁用；成功后使用最新 expectedRevision"}
  ],
  "coreOperations": [
